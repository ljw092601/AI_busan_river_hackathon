# ─────────────────────────────────────────────────────────────
# 환경변수 템플릿
#
# 사용법: 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
#
# ⚠️ .env.local 은 .gitignore 에 등록되어 있습니다. 절대 커밋하지 마세요.
# ⚠️ 이 파일(.env.example)에는 실제 값을 넣지 마세요. 커밋되는 파일입니다.
# ─────────────────────────────────────────────────────────────


# =============================================================
# 1. 클라이언트 노출 OK — VITE_ 접두사
# =============================================================
#
# ⚠️ VITE_ 접두사는 편의 기능이 아니라 보안 경계입니다.
#    Vite는 빌드 시 VITE_ 로 시작하는 변수만 클라이언트 코드에 치환해 넣습니다.
#    여기 적은 값은 브라우저 개발자도구에서 누구나 볼 수 있다고 가정하세요.

# Supabase — anon key는 공개 전제로 설계된 키입니다 (RLS로 보호)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# 카카오맵 JavaScript 키
#   Kakao Developers → 내 애플리케이션 → 앱 키 → JavaScript 키
#   ⚠️ 플랫폼 → Web 에 아래 도메인 등록 필수. 안 하면 로컬에서도 지도가 안 뜹니다.
#        http://localhost:5173
#        http://localhost:4173
#        https://<배포도메인>
#   이 키는 노출이 불가피하며, 도메인 화이트리스트가 유일한 보호 수단입니다.
VITE_KAKAO_MAP_KEY=

# 종 판별 엔진 선택 (PLAN.md §7.5) — 키가 아니라 스위치입니다
#   none    D안 폴백. 모델 없이 아이 선택만 → 전부 검수 큐(pending). 기본값
#   mock    결정론적 목 어댑터. 개발·테스트용
#   claude  Supabase Edge Function 경유 Claude API
#   ⚠️ claude로 두고 VITE_SUPABASE_URL/ANON_KEY가 비어 있으면
#      크래시하지 않고 자동으로 none(D안)으로 내려갑니다.
VITE_CLASSIFIER_ENGINE=none

# 선택. 비우면 claude-opus-5. 파일럿에서 저비용 모델과 일치율 비교 시 사용
VITE_CLASSIFIER_MODEL=


# =============================================================
# 2. 서버 전용 — 절대 VITE_ 를 붙이지 마세요
# =============================================================
#
# 아래 값들은 로컬 스크립트/CLI 편의를 위해 여기 둘 수 있지만,
# 실제 런타임에서는 Supabase Edge Function secrets 로 올라가야 동작합니다.
# .env.local 에 적어두는 것만으로는 Edge Function 이 읽지 못합니다.
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-... KMA_SERVICE_KEY=...
#
# ⛔ 여기에 VITE_ 를 붙이는 순간 번들 JS에 평문으로 박혀 배포됩니다.

# Supabase service_role — RLS를 우회하는 마스터 키. 유출 시 전체 데이터 노출.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — 종 판별 (PLAN.md §7.5)
#   platform.claude.com → API keys
ANTHROPIC_API_KEY=

# 기상청 — 호우/홍수 시 코스 자동 비활성화 (PLAN.md §5.3, 아동 안전)
#   data.go.kr → 기상청_단기예보 조회서비스 + 기상특보 조회서비스 활용신청
KMA_SERVICE_KEY=


# =============================================================
# 3. 여기 넣어도 소용없는 것 — 참고
# =============================================================
#
# ▸ MCP project ref  → C:\Users\ljw09\.claude.json 의
#                       mcpServers.supabase.args 의 --project-ref
#                       .env 를 읽지 않습니다. 변경 후 Claude Code 재시작 필요.
#
# ▸ DB password      → Supabase CLI 로 직접 psql 접속할 때만 필요.
#                       마이그레이션은 MCP(access token)로 적용하므로 보통 불필요.
#                       필요해지면 SUPABASE_DB_PASSWORD 로 추가하세요.
